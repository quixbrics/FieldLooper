{
  "name": "fieldlooper",
  "version": "0.1.0",
  "description": "Record the world on an iPhone, stretch it into drones — fourth companion to ScapeMaker, ToneMaker and FXMaker. Static, backend-free PWA.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "private": true,
  "type": "module"
}
